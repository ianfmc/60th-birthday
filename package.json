{
  "name": "celebrating-sixty-choices",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-s3-site.mjs",
    "start": "next start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern out --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "flights:check": "node scripts/check-flights.mjs",
    "deploy": "bash scripts/deploy-s3.sh",
    "deploy:control": "bash scripts/deploy-control.sh"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Celebrating Sixty"
}
